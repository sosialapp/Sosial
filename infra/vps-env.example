# Copy to `.env` next to docker-compose.services.yml on the VPS.
# Fill from the secret audit (provider consoles). NEVER commit `.env`.
# Names mirror Supabase secrets + worker/.env.example so nothing gets lost.

# --- new instance keys (minted in Stage 1, replace everywhere at cutover) ---
# WORKER_SERVICE_ROLE_KEY=
# NEW_ANON_KEY=

# --- channel OAuth clients (values from provider consoles) ---
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
IG_APP_ID=
IG_APP_SECRET=
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
X_CLIENT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
LI_CLIENT_ID=
LI_CLIENT_SECRET=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
PIN_CLIENT_ID=
PIN_CLIENT_SECRET=
# true while the Pinterest app has Trial access: pins and boards use the API
# sandbox (visible only to you). Also set it in the Supabase functions .env.
PIN_SANDBOX=
# Sandbox access token from the Pinterest developer portal (the sandbox rejects
# OAuth tokens). Needed when PIN_SANDBOX=true; also in the Supabase functions .env.
PIN_SANDBOX_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- web (self-hosted Next.js; NEXT_PUBLIC_* are BUILD-time values) ---
# Changing any NEXT_PUBLIC_* below requires `docker compose build web`.
NEXT_PUBLIC_SUPABASE_URL=https://db.sosial.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://sosial.app
# NEXT_PUBLIC_DOCS_URL=https://docs.sosial.app
# NEXT_PUBLIC_DASHBOARD_URL=
# Web reuses WORKER_SERVICE_ROLE_KEY for SUPABASE_SERVICE_ROLE_KEY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- services ---
OPENAI_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sosial-media
R2_PUBLIC_URL=
# Separate R2 token scoped to the sosial-backups bucket (Object Read & Write)
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
TT_PHOTO_HOST=
TT_PHOTO_HOST_PUBLIC=
TT_PHOTO_HOST_KEY=
DORMANCY_TOKEN=
SITE_URL=https://sosial.app
MEDIA_ENV=prod

# --- website analytics (Umami) ---
# Both from `openssl rand -hex 32`. Hex only: the password goes inside a URL.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# BUILD-time: set after adding the site in Umami, then `docker compose build web`.
NEXT_PUBLIC_UMAMI_URL=https://stats.sosial.app
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- monitoring (Beszel hub "Add System" dialog → KEY + TOKEN) ---
BESZEL_KEY=
BESZEL_TOKEN=

# --- photo-host public URL (behind Cloudflare, set at cutover) ---
# Must match EXPO_PUBLIC_TT_PHOTO_HOST semantics: full upload URL incl. ?key=
