# Billing (Stripe) — copy to .env.local and fill in.
#
# 1. Create 6 recurring Prices in Stripe (USD), one per plan+interval:
#      Solo:     $12/month, $120/year
#      Team:     $29/month, $290/year
#      Business: $79/month, $790/year
# 2. Put each Price ID (price_...) below — the IDs are the source of truth.
#    The interval is resolved from the Price ID, never from the amount.
# 3. Add a webhook endpoint → https://YOUR-DOMAIN/api/billing/webhook with
#    events: checkout.session.completed, customer.subscription.created,
#    customer.subscription.updated, customer.subscription.deleted,
#    invoice.paid, invoice.payment_failed.
# 4. SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role key
#    (server-only; the webhook uses it to sync subscription state).

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
SUPABASE_SERVICE_ROLE_KEY=
