{
  "expo": {
    "name": "Sosial",
    "slug": "sosial",
    "scheme": "sosial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sosial.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Sosial saves your infographic posts to your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Sosial saves your infographic posts to your photo library."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.sosial.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#1C1A14"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Sosial needs access to your photos to use custom backgrounds and profile pictures."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Sosial saves your posts to your gallery.",
          "savePhotosPermission": "Sosial saves your posts to your gallery."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFC62E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#F7F6F3",
          "imageWidth": 220
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "b8bbcdae-f3cc-41d7-8372-955bc1326223"
      }
    },
    "owner": "naqibhusainiis-team",
    "updates": {
      "url": "https://u.expo.dev/b8bbcdae-f3cc-41d7-8372-955bc1326223"
    }
  }
}
