# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# Use the SAME Supabase project as the mobile app so web and mobile share
# workspaces, connected channels, posts, schedules and the post-media bucket.
# This is the public anon key only — service_role NEVER goes in here.

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY

# Absolute URL of this app, used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
