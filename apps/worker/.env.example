# Placeholder — copy to `.env`. Never commit real keys.
WORKER_SUPABASE_URL=https://xyzcompany.supabase.co
WORKER_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY
# YouTube cloud publishing — same Google OAuth client the app ships as
# EXPO_PUBLIC_YT_CLIENT_ID / EXPO_PUBLIC_YT_CLIENT_SECRET (required to publish
# scheduled YouTube videos while the app is closed).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# TikTok cloud publishing — same app credentials the app ships as
# EXPO_PUBLIC_TT_CLIENT_KEY / EXPO_PUBLIC_TT_CLIENT_SECRET (client_key, not
# client_id). Required to refresh the 24h access token while closed.
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
# Shared photo-host fallback (full upload URL incl. ?key=) when a channel has
# no Connect → TikTok override. Server-side only — never EXPO_PUBLIC_.
TT_PHOTO_HOST=
# LinkedIn cloud publishing — same OAuth client the app ships as
# EXPO_PUBLIC_LI_CLIENT_ID / EXPO_PUBLIC_LI_CLIENT_SECRET. Required to refresh
# the ~60d access token while closed.
LI_CLIENT_ID=
LI_CLIENT_SECRET=
# Pinterest cloud publishing — same app credentials the app ships as
# EXPO_PUBLIC_PIN_CLIENT_ID / EXPO_PUBLIC_PIN_CLIENT_SECRET. Required to
# refresh the ~30d access token while closed (HTTP Basic, like the app).
PIN_CLIENT_ID=
PIN_CLIENT_SECRET=
# Invite retry emails point at the web redeem page (Bearer-site default).
WORKER_SITE_URL=https://sosial.app
# Cloudflare R2 media store (zero-egress replacement for Supabase Storage).
# Create an API token with Object Read & Write on the bucket, then paste here.
# The bucket is one R2 bucket; prefixes mirror the old Supabase buckets
# (post-media/… private, blog-media/… public).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sosial-media
# Public custom domain bound to the bucket (for blog media + thumbnails), no
# trailing slash. Leave blank until the domain is set up.
R2_PUBLIC_URL=
# Environment segment in object keys: post-media/<env>/<workspace_id>/… Keep
# the worker and the edge `media` function (MEDIA_ENV) on the same value.
MEDIA_ENV=prod
# Reads/deletes: 'supabase' (default, unchanged) · 'both' (dual-write) · 'r2'
# (R2 first, Supabase read fallback). Flip to 'both' once the bucket exists.
STORAGE_BACKEND=supabase
# Optional tuning
WORKER_IDLE_MS=5000
WORKER_ERROR_MS=15000
