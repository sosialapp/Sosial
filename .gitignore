# local env — provider secrets live here, never commit
.env
.env.local

# dependencies
node_modules/

# expo
.expo/
dist/
web-build/

# native build outputs (regenerated by prebuild + gradle)
android/build/
android/app/build/
android/.gradle/
android/local.properties
*.hprof

# signing keys — never commit
*.jks
*.keystore

# firebase client config — google-services.json ships with the build
# (EAS has no upload slot for it in this CLI/dashboard version).
# Lock it down instead: Google Cloud Console → APIs & Services →
# Credentials → restrict the Android key to com.sosial.app + your SHA-1.
GoogleService-Info.plist

# logs / os
*.log
.DS_Store
Thumbs.db

# misc
.eps/

# tiktok-photo-host: uploaded bytes (ephemeral) + local env
apps/tiktok-photo-host/data/
apps/tiktok-photo-host/.env
.vercel
.env*
